PORT=4000
NODE_ENV=development

# Odoo (mismo formato que tu app actual)
ODOO_URL=https://TUINSTANCIA.dev.odoo.com
ODOO_DB=TU_DB
ODOO_USERNAME=sistemas@tuempresa.com
ODOO_PASSWORD=TU_API_KEY_O_PASSWORD
ODOO_COMPANY_ID=1

# Nombre de lista de precios cliente final
ODOO_CUSTOMER_PRICELIST_NAME="Predeterminado (ARS)"

# SOLO DEV (por el cert en *.dev.odoo.com)
ALLOW_INSECURE_TLS=true

# API de la app Informe (ventas-api): calcula las comisiones de vendedores.
# Presupuestador consulta /comisiones ahí para mostrarle a cada vendedor lo
# que lleva comisionado. Si el host de Informe cambia, actualizar acá.
INFORMES_API_BASE=https://informesdgportones-vp3y.onrender.com

# Recuperacion de contrasena ("Olvidaste tu contrasena?"), ver src/mailer.js.
# Key de resend.com (alcanza con permiso "Sending access"). Sin key no se mandan emails.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend. Vacio = onboarding@resend.dev, que
# solo puede mandar al email duenio de la cuenta de Resend (sirve para probar).
MAIL_FROM=De Grandis Portones <no-reply@envios.degrandisportones.com>
# URL del front para armar el link del email (default: el de Vercel de produccion).
PASSWORD_RESET_BASE_URL=https://presupuestador-degrandisportones.vercel.app
# SOLO DEV: 1 = ademas imprime el link en la consola del backend.
MAIL_DEV_LOG_LINKS=
